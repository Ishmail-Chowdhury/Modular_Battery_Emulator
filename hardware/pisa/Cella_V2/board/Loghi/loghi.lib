#
# LogoDII
#
DEF LogoDII U 0 40 Y Y 1 F N
F0 "U" 0 100 50 H I C CNN
F1 "LogoDII" 0 0 50 H V C CNN
F2 "loghi:logo_dii" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
DRAW
S -200 50 200 -50 0 1 0 N
ENDDRAW
ENDDEF
