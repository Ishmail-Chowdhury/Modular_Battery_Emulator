(text "ON-BOARD CVE READBACK" (at 433.07 74.93 0) (effects (font (size 2.54 2.54)) (justify left)) (uuid "9d551316-ca00-5855-a33c-df8de5f5bb72"))
(text "CVE R44 -> U3 S3 -> C1-C8 S3 -> U8 B1-B8" (at 433.07 81.28 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "8621495e-ef92-5358-969a-4f342a9e481e"))
(text "U8 A -> M1 pin 33. M1 pins 26 / 28 / 30 = address A0 / A1 / A2." (at 433.07 133.35 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "92460d4f-85c1-53b5-97bb-6c2cacbabfdb"))
(text "Bus1 / M1.39 = 3.3 V. Bus2 / M1.40 = FPGA signal return." (at 433.07 138.43 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "aa78e1da-3608-5d56-85f3-4dd65bbb3f91"))
(text "Aux12 pins 7-9 are disconnected. Bus7 remains between legacy I1 and T1." (at 433.07 143.51 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "9a633f12-3acf-5bab-ba18-f2ecb7f04977"))
(text "Fit CVE R40 / R42 / R44 and leave J2 / J3 / J4 unbridged." (at 433.07 148.59 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "4544fcb9-2b7f-585d-b329-bfe8b722daf1"))
(text "Set mux address before asserting the slot ADC chip select." (at 433.07 153.67 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "4d84b34c-42d8-5f7f-ba11-9c15dd8db17b"))
